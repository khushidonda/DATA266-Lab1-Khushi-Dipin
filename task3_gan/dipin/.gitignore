# local environment
.venv/
# resume state and periodic snapshots are large; final per-network weights are committed
checkpoints/latest.pt
checkpoints/latest.tmp
checkpoints/generators_epoch*.pt
checkpoints/smoke/
outputs/smoke/
# Kaggle submission archive (upload artifact, regenerated by make_submission.py)
outputs/kaggle_submission/images/
outputs/kaggle_submission/images.zip
# v2 run: same policy
checkpoints/v2/latest.pt
checkpoints/v2/latest.tmp
checkpoints/v2/generators_epoch*.pt
checkpoints/v2/smoke/
outputs/v2/smoke/
outputs/v2/kaggle_submission/images/
outputs/v2/kaggle_submission/images.zip
# v2 held-out translation dumps stay local (per-image metrics are committed)
outputs/v2/translations/
