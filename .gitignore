# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# Hugging Face / dataset caches
.cache/
**/.huggingface/
**/hf_cache/

# Raw / large dataset artifacts (never commit raw TinyStories or similar)
**/raw/
*.arrow
*.parquet

# Large generated array/tensor caches (not model checkpoints — those are kept)
*.npy
*.npz
*.h5
*.hdf5

# Khushi Task 3 CycleGAN training checkpoints (~340 MB each, over GitHub's
# 100 MB file limit). Only the .pt weights are ignored; SHA-256 hashes are
# recorded in the raw logs/manifests.
task3_gan/khushi/checkpoints/**/*.pt

# Datasets, run outputs and local backups live outside the repo; guard against
# accidental copies being committed.
*.zip
**/dataset/
**/monet_jpg/
**/photo_jpg/
DATA266_runs/
DATA266_data/
DATA266_BACKUP_*/
DATA266_CRITICAL_UPLOAD/

# Virtual environments
.venv/
venv/
env/

# Reproducible caches and local scratch (final evaluation features can be regenerated with evaluate_final.py)
task3_gan/khushi/outputs/final_eval_epoch029/cache/
**/.ipynb_checkpoints/
**/.venv/
