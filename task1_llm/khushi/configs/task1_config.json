{
  "run_id": "",
  "seed": 42,

  "data": {
    "train_size": 100000,
    "validation_size": 10000,
    "sequence_length": 128
  },

  "model": {
    "embedding_dim": 128,
    "num_heads": 4,
    "num_transformer_blocks": 4,
    "feed_forward_dim": 256,
    "dropout": 0.1
  },

  "training": {
    "batch_size": 64,
    "optimizer": "AdamW",
    "weight_decay": 0.01,
    "learning_rate": 3e-4,
    "warmup_steps": 1000,
    "scheduler": "cosine",
    "epochs": 10
  },

  "generation": {
    "method": "temperature",
    "temperature": 0.8,
    "max_new_tokens": 200
  },

  "hardware": {
    "device": "",
    "gpu": ""
  }
}
